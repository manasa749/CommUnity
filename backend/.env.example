# CommUnity Environment Variables Template
# Copy this file to '.env' in the same folder and set configuration values

# Secret key for JWT generation (Use a long random string of at least 32 bytes)
JWT_SECRET=your_long_random_jwt_secret_key_here

# JWT parameters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# PostgreSQL connection string (libpq DSN format)
# Local development:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/community
# Google Cloud SQL (public IP):
#   DATABASE_URL=postgresql://user:password@<CLOUD_SQL_PUBLIC_IP>:5432/community
# Google Cloud SQL (Unix socket, for Cloud Run):
#   DATABASE_URL=postgresql://user:password@/community?host=/cloudsql/<PROJECT>:<REGION>:<INSTANCE>
DATABASE_URL=postgresql://postgres:password@localhost:5432/community
