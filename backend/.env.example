# CommUnity Environment Variables Template
# Copy this file to '.env' in the same folder and set configuration values

# Secret key for JWT generation (Use a long random string of at least 32 bytes)
JWT_SECRET=your_long_random_jwt_secret_key_here

# JWT parameters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---------------------------------------------------------------------------
# Cloud SQL connection (used by the Cloud SQL Python Connector)
# ---------------------------------------------------------------------------
# Format: <project-id>:<region>:<instance-name>
INSTANCE_CONNECTION_NAME=your-project:your-region:your-instance

# PostgreSQL database name
DB_NAME=community

# PostgreSQL user and password
DB_USER=community_user
DB_PASSWORD=your_database_password_here
